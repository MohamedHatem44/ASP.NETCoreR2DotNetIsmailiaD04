@model List<EmployeeReadVM>

<h1 class="d-flex justify-content-center text-success">
    All Employees
</h1>

<div class="d-flex justify-content-center gap-3 mb-3">
    <a asp-action="CreateV01" asp-controller="Employee" class="btn btn-success">
        Create New Employee V01
    </a>
    <a asp-action="CreateV02" asp-controller="Employee" class="btn btn-success">
        Create New Employee V02
    </a>
</div>

<hr />
<br />
<br />

<table class="table text-center">
    <thead>
        <tr>
            <th scope="col">Id</th>
            <th scope="col">Name</th>
            <th scope="col">Age</th>
            <th scope="col">Salary</th>
            <th scope="col">Department</th>
            <th scope="col">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var emp in Model)
        {
            <tr>
                <td>@emp.Id</td>
                <td>@emp.Name</td>
                <td>@emp.Age</td>
                <td>@emp.Salary</td>
                <td>@emp.Department</td>
                <td>
                    <a asp-action="Details" asp-controller="Employee" asp-route-id="@emp.Id" class="btn btn-primary">
                        Details
                    </a>
                    <a asp-action="Edit" asp-controller="Employee" asp-route-id="@emp.Id" class="btn btn-outline-secondary">
                        Edit
                    </a>
                    <a asp-action="Delete" asp-controller="Employee" asp-route-id="@emp.Id" class="btn btn-outline-danger">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>