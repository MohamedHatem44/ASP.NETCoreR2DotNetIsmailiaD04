@model EmployeeEditVM

<h1 class="d-flex justify-content-center text-success">
    Edit Employee
</h1>

<hr />
<br />
<br />

<form asp-action="Edit" asp-controller="Employee" method="post">

    <input type="text" class="form-control" id="Id" name="Id" placeholder="Enter Id" required value="@Model.Id" hidden />

    <div class="mb-3 form-group">
        <label asp-for="Name" class="form-label"></label>
        <input type="text" class="form-control" asp-for="Name" />
    </div>

    <div class="mb-3 form-group">
        <label asp-for="Age" class="form-label"></label>
        <input type="text" class="form-control" asp-for="Age" />
    </div>

    <div class="mb-3 form-group">
        <label asp-for="Salary" class="form-label"></label>
        <input type="text" class="form-control" asp-for="Salary" />
    </div>

    <div class="mb-3 form-group">
        <label asp-for="DepartmentId" class="form-label"></label>
        <select class="form-select" asp-for="DepartmentId" asp-items="Model.Departments">
        </select>
    </div>

    <div class="d-flex justify-content-center gap-3">
        <input type="submit" class="btn btn-success" value="Save" />
        <a asp-action="Index" asp-controller="Employee" class="btn btn-outline-secondary">Cancel</a>
    </div>

</form>