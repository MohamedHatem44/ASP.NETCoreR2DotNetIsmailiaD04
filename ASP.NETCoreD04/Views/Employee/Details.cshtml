@model EmployeeReadVM

<h1 style="color:green; text-align:center">
    Employee Details
</h1>

<div class="card" style="width: 18rem;">
    <div class="card-body">
        <h5 class="card-title">Employee Id: @Model.Id</h5>
        <p class="card-text">Name: @Model.Name</p>
        <p class="card-text">Age: @Model.Age</p>
        <p class="card-text">Salary: @Model.Salary</p>
        <p class="card-text">Department: @Model.Department</p>
        <a asp-action="Index" asp-controller="Employee" class="btn btn-outline-secondary">Back to List</a>
    </div>
</div>