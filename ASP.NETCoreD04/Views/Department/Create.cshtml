@model DepartmentCreateVM

<div class="d-flex justify-content-center">
    <h1 class="text-success">Create Department</h1>
</div>

<br />
<hr />
<br />

<form action="~/Department/Create" method="post">

    <div class="mb-3 form-group">
        <label for="Name" class="form-label">Name</label>
        <input type="text" class="form-control" id="Name" name="Name" required />


        @* @Html.LabelFor(m => m.Name, new { @class = "form-label" })
        @Html.TextBox("Name")
        @Html.TextBoxFor(m => m.Name) *@
    </div>


    <div class="mb-3 form-group">
        @Html.LabelFor(m => m.Name, new { @class = "form-label" })
        @Html.TextBoxFor(d => d.Name, new
        {
            @class = "form-control" ,
                required = "required",
                placeholder = "Enter Department name"
                })
        @Html.ValidationMessageFor(d => d.Name, null , new { @class = "text-danger" })
        @* @Html.EditorFor() *@
    </div>

    <div class="d-flex justify-content-center gap-3">
        <input type="submit" class="btn btn-success" value="Create Department" />
      @* <a href="~/Department/Index" class="btn btn-secondary">Cancel</a>  *@
        @Html.ActionLink("Cancel", "Index", "Department", null, new { @class = "btn btn-secondary" })
    </div>

</form>

@using (Html.BeginForm("Create", "Department", FormMethod.Post))
{
    <div class="mb-3 form-group">
        @Html.LabelFor(m => m.Name, new { @class = "form-label" })
        @Html.TextBoxFor(d => d.Name, new
        {
            @class = "form-control" ,
        required = "required",
        placeholder = "Enter Department name"
        })
    @Html.ValidationMessageFor(d => d.Name, null, new { @class = "text-danger" })
    </div>

<div class="d-flex justify-content-center gap-3">
    <input type="submit" class="btn btn-success" value="Create Department" />
    @Html.ActionLink("Cancel", "Index", "Department", null, new { @class = "btn btn-secondary" })
</div>
}
